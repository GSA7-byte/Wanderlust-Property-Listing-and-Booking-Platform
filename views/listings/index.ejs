<% layout("/layouts/boilerplate") %>
<!-- <h3 class="mt-3">All Listings</h3> -->

<style>
  #filters {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }
  .filter {
    text-align: center;
    margin-right: 1rem;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }
  .filter:hover {
    opacity: 1;
    cursor: pointer;
    text-decoration: underline;
  }
  .filter p{
    font-size: 0.8rem;
  }
  .tax-toggle {
    margin-left: auto;
    border: 1px solid #ccc;
    border-radius: 20px;
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
  }
</style>
<div id="filters">

  <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault"><b>After Taxes</b></label>
      </div>
  </div>

  <div class="filter">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-cow"></i></div>
    <p>Farms</p>
  </div>
  <div class="filter">
    <div><i class="fa-regular fa-snowflake"></i></div>
    <p>Arctic</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-umbrella-beach"></i></div>
    <p>Beachfront</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain-sun"></i></div>
    <p>Amazing Views</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-tree"></i></div>
    <p>Cabins</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-city"></i></div>
    <p>Top Cities</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-house-chimney-window"></i></div>
    <p>A-frames</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-water"></i></div>
    <p>Lake</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-van-shuttle"></i></div>
    <p>Campervans</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-seedling"></i></div>
    <p>Vineyards</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-person-skiing"></i></div>
    <p>Ski-in/out</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-chess-rook"></i></div>
    <p>Towers</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-guitar"></i></div>
    <p>Creative Spaces</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-kitchen-set"></i></div>
    <p>Chef's Kitchens</p>
  </div>
</div>


<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for(let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
    <div class="col mb-4">
      <div class="card h-100 listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem; object-fit: cover;">
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b> <br>
            ₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
            <i>&nbsp;+18% GST</i>
          </p>
        </div>
      </div>
    </div>
    </a>
  <% } %>
</div>

<script>
  // 1. Select the toggle and all price elements
  const taxToggle = document.querySelector("#switchCheckDefault");
  const priceElements = document.querySelectorAll(".card-text");

  taxToggle.addEventListener("change", function() {
    priceElements.forEach(el => {
      // 2. INITIALIZATION: Store original price in 'data-base-price' once
      if (!el.dataset.basePrice) {
        let priceMatch = el.textContent.match(/₹\s?([\d,]+)/);
        if (priceMatch) {
          // Store only the numbers, removing commas
          el.dataset.basePrice = priceMatch[1].replace(/,/g, '');
        }
      }

      // 3. RETRIEVAL: Always use the stored base price for calculations
      let basePrice = parseInt(el.dataset.basePrice);

      // 4. TOGGLE LOGIC
      if (this.checked) {
        let taxAmount = Math.round(basePrice * 0.18);
        let total = basePrice + taxAmount;
        // Format to Indian currency style
        
        el.textContent = `₹ ${total.toLocaleString("en-IN")} / night (incl. taxes)`;
      } else {
        // Return exactly to the original format
        el.textContent = `₹ ${basePrice.toLocaleString("en-IN")} / night`;
      }
    });
  });
</script>
